# Environment Configuration
# Copy this file to .env and update values

# API Settings
API_TITLE="AI-Driven Patrolling & Bandobast API"
API_VERSION="1.0.0"
DEBUG=false

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/patrolling.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/patrolling

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
API_KEY=your-secret-api-key
RATE_LIMIT_PER_MINUTE=100

# RAG Settings
VECTOR_STORE_PATH=data/vectordb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# CopMap Integration (optional)
COPMAP_WEBHOOK_URL=
COPMAP_API_KEY=
